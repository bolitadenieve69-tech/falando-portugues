EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
EXPO_PUBLIC_APP_TOKEN=
EXPO_PUBLIC_PRIVACY_URL=https://falando-portugues.app/privacy

# Crash reporting — leave EMPTY to keep reporting fully disabled (no network calls).
# Paste the DSN from sentry.io to switch it on. Requires a new dev build:
# @sentry/react-native is a native module.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENV=beta
