ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=        # Find a PT-PT voice at elevenlabs.io/voice-library
LIVEKIT_URL=                # wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Security — generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
APP_TOKEN=                  # Shared token required in X-App-Token header; leave empty to disable check in dev
ALLOWED_ORIGINS=*           # Comma-separated list of allowed origins; use specific domain(s) in production

# Session behaviour
TOKEN_TTL_DAYS=30           # Days before a session token expires; login refreshes it
MAX_SESSION_MINUTES=30      # Hard cap on a voice session before the bot pipeline is cancelled
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2  # Try eleven_flash_v2_5 for lower latency (A/B test PT-PT quality)

# Measurement
# Per-turn latency records, one JSON object per line. Defaults to latency.jsonl
# next to the database (so the Docker volume keeps it). Set empty to disable.
# Analyse with: python scripts/latency_report.py /data/latency.jsonl
LATENCY_LOG=/data/latency.jsonl

# Silence that ends the learner's turn, in ms. Empty uses a per-level default
# (2200 for A1 down to 1200 for C2): beginners pause far more looking for words,
# and too short a value cuts them off mid-sentence.
DEEPGRAM_ENDPOINTING_MS=
